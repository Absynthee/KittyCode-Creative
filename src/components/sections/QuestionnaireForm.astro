---
import Button from "@/components/ui/Button.astro";
import Input from "@/components/ui/Input.astro";
import Label from "@/components/ui/Label.astro";
import Textarea from "@/components/ui/Textarea.astro";
import Radio from "@/components/ui/Radio.astro";
import { abs } from "@/lib/schema";

interface Props {
  /** Web3Forms access key */
  accessKey?: string;
  variant?:
    | "default"
    | "primary"
    | "secondary"
    | "info"
    | "success"
    | "warning"
    | "error";
  size?: "small" | "medium" | "large";
}

const {
  accessKey = "686b7c11-3bbc-4c8b-8f7b-ec3e5f7aa0f5",
  variant = "primary",
  size = "medium",
} = Astro.props;

const labelColors = {
  default: "var(--foreground)",
  primary: "var(--primary)",
  secondary: "var(--secondary-foreground)",
  info: "var(--info)",
  success: "var(--success)",
  warning: "var(--warning)",
  error: "var(--error)",
};

const labelSizes = {
  small: "var(--step--2)",
  medium: "var(--step--1)",
  large: "var(--step-0)",
};

const budgets = [
  "Prefer a monthly plan",
  "Up to £1,500",
  "£1,500 to £3,500",
  "£3,500 to £6,000",
  "£6,000+",
  "Not sure yet",
];

const timelines = [
  "As soon as possible",
  "1 to 3 months",
  "3 to 6 months",
  "No fixed deadline",
];
---

<div
  class="questionnaire-form"
  style={`--legend-color: ${labelColors[variant]}; --legend-size: ${labelSizes[size]};`}
>
  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    class="questionnaire-form-inner"
    novalidate
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Website Questionnaire" />
    <input type="hidden" name="from_name" value="KittyCode Creative Website" />
    {/* No-JS fallback: Web3Forms redirects here after a native POST */}
    <input type="hidden" name="redirect" value={abs("/thank-you")} />

    <h3 class="questionnaire-heading">Your Details</h3>
    <div class="questionnaire-fields">
      <fieldset class="questionnaire-field">
        <Label htmlFor="q-name" variant={variant} size={size} required>
          Your Name
        </Label>
        <Input
          id="q-name"
          name="name"
          type="text"
          placeholder=""
          autocomplete="name"
          variant={variant}
          size={size}
          required
        />
      </fieldset>

      <fieldset class="questionnaire-field">
        <Label htmlFor="q-business-name" variant={variant} size={size} required>
          Business Name
        </Label>
        <Input
          id="q-business-name"
          name="Business Name"
          type="text"
          placeholder=""
          autocomplete="organization"
          variant={variant}
          size={size}
          required
        />
      </fieldset>

      <fieldset class="questionnaire-field questionnaire-field--full">
        <Label htmlFor="q-email" variant={variant} size={size} required>
          Email Address
        </Label>
        <Input
          id="q-email"
          name="email"
          type="email"
          placeholder=""
          autocomplete="email"
          variant={variant}
          size={size}
          required
        />
      </fieldset>
    </div>

    <h3 class="questionnaire-heading">Your Business</h3>
    <div class="questionnaire-fields">
      <fieldset class="questionnaire-field questionnaire-field--full">
        <Label
          htmlFor="q-business-about"
          variant={variant}
          size={size}
          required
        >
          Tell us about your business and who you're trying to reach
        </Label>
        <Textarea
          id="q-business-about"
          name="About the business and audience"
          placeholder="What you do, and the customers you want to attract."
          variant={variant}
          size={size}
          rows={3}
          required
          autoResize={true}
        />
      </fieldset>

      <fieldset class="questionnaire-field questionnaire-field--full">
        <Label htmlFor="q-purpose" variant={variant} size={size} required>
          What should the website achieve?
        </Label>
        <Textarea
          id="q-purpose"
          name="What should the website achieve?"
          placeholder="More enquiries, online sales, somewhere to send people. Whatever success looks like for you."
          variant={variant}
          size={size}
          rows={3}
          required
          autoResize={true}
        />
      </fieldset>

      <fieldset class="questionnaire-field">
        <Label
          htmlFor="q-existing-website"
          variant={variant}
          size={size}
          optional
        >
          Do you already have a website?
        </Label>
        <Input
          id="q-existing-website"
          name="Existing website"
          type="url"
          placeholder="https://yourwebsite.com"
          variant={variant}
          size={size}
        />
      </fieldset>

      <fieldset class="questionnaire-field">
        <Label htmlFor="q-brand-assets" variant={variant} size={size} optional>
          What brand assets do you already have?
        </Label>
        <Textarea
          id="q-brand-assets"
          name="Existing brand assets"
          placeholder="A logo, brand guide, colours or fonts."
          variant={variant}
          size={size}
          rows={2}
          autoResize={true}
        />
      </fieldset>
    </div>

    <h3 class="questionnaire-heading">Your Project</h3>

    <fieldset class="questionnaire-options">
      <legend class="questionnaire-legend">
        What is your budget for the project?
      </legend>
      <div class="questionnaire-choices">
        {
          budgets.map((budget) => (
            <Radio name="Budget" value={budget} variant={variant} size={size}>
              {budget}
            </Radio>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="questionnaire-options">
      <legend class="questionnaire-legend">
        When would you like to launch?
      </legend>
      <div class="questionnaire-choices">
        {
          timelines.map((timeline) => (
            <Radio
              name="Timeline"
              value={timeline}
              variant={variant}
              size={size}
            >
              {timeline}
            </Radio>
          ))
        }
      </div>
    </fieldset>

    <div class="questionnaire-fields">
      <fieldset class="questionnaire-field questionnaire-field--full">
        <Label
          htmlFor="q-websites-liked"
          variant={variant}
          size={size}
          optional
        >
          Any websites you like the look of?
        </Label>
        <Textarea
          id="q-websites-liked"
          name="Websites you like"
          placeholder="Links to any sites whose style appeals to you, and what you like about them."
          variant={variant}
          size={size}
          rows={3}
          autoResize={true}
        />
      </fieldset>

      <fieldset class="questionnaire-field questionnaire-field--full">
        <Label htmlFor="q-extra-info" variant={variant} size={size} optional>
          Anything else you feel might be important?
        </Label>
        <Textarea
          id="q-extra-info"
          name="Extra information"
          placeholder="Anything that isn't mentioned above, or something you want to expand on."
          variant={variant}
          size={size}
          rows={4}
          autoResize={true}
        />
      </fieldset>
    </div>

    {/* Honeypot field for spam bots */}
    <input
      type="checkbox"
      name="botcheck"
      class="botcheck"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <div class="questionnaire-actions">
      <Button type="submit" variant={variant} size={size}>
        Submit Questionnaire
      </Button>
    </div>

    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
</div>

<script>
  import {
    getHTMLElements,
    getHTMLElement,
    findElements,
    addElementClass,
    removeElementClass,
    isInputElement,
    isTextAreaElement,
    getFormValue,
  } from "@/lib/utils";

  document.addEventListener("astro:page-load", () => {
    const questionnaireForms = getHTMLElements(".questionnaire-form");

    questionnaireForms.forEach((wrapper) => {
      const form = getHTMLElement("form", wrapper) as HTMLFormElement | null;
      if (!form) return;

      const inputs = findElements(
        "input[required], textarea[required]",
        wrapper,
      );
      const status = getHTMLElement(".form-status", wrapper);

      inputs.forEach((input) => {
        input.addEventListener("blur", validateField);
        input.addEventListener("input", clearErrorOnInput);
      });

      form.addEventListener("submit", handleSubmit);

      function getFieldError(
        input: HTMLInputElement | HTMLTextAreaElement,
      ): string | null {
        const value = getFormValue(input);
        if (input.required && !value.trim()) {
          return `${getLabelText(input)} is required`;
        }
        if (value.trim() && input.type === "email") {
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(value)) {
            return "Please enter a valid email address";
          }
        }
        return null;
      }

      function getLabelText(
        input: HTMLInputElement | HTMLTextAreaElement,
      ): string {
        const label = getHTMLElement(`label[for="${input.id}"]`, wrapper);
        return label
          ? label.textContent?.replace("*", "").trim() || "Field"
          : "Field";
      }

      function validateField(event: Event) {
        const input = event.target;
        if (!isInputElement(input) && !isTextAreaElement(input)) return;
        const field = input.closest(".questionnaire-field") as HTMLElement;
        if (!field) return;
        clearErrors(field);
        const error = getFieldError(input);
        if (error) showError(field, error);
      }

      function clearErrorOnInput(event: Event) {
        const input = event.target;
        if (!isInputElement(input) && !isTextAreaElement(input)) return;
        const field = input.closest(".questionnaire-field") as HTMLElement;
        if (!field) return;
        if (
          getFormValue(input).trim() &&
          field.classList.contains("field--error")
        ) {
          clearErrors(field);
        }
      }

      function showError(field: HTMLElement, message: string) {
        addElementClass(field, "field--error");
        let errorEl = getHTMLElement(".error-message", field);
        if (!errorEl) {
          errorEl = document.createElement("span");
          addElementClass(errorEl, "error-message");
          field.appendChild(errorEl);
        }
        errorEl.textContent = message;
      }

      function clearErrors(field: HTMLElement) {
        removeElementClass(field, "field--error");
        const errorEl = getHTMLElement(".error-message", field);
        if (errorEl) errorEl.remove();
      }

      async function handleSubmit(event: Event) {
        event.preventDefault();
        let hasErrors = false;

        inputs.forEach((input) => {
          if (!isInputElement(input) && !isTextAreaElement(input)) return;
          const field = input.closest(".questionnaire-field") as HTMLElement;
          if (!field) return;
          clearErrors(field);
          const error = getFieldError(input);
          if (error) {
            showError(field, error);
            hasErrors = true;
          }
        });

        if (hasErrors) {
          const firstError = wrapper.querySelector(
            ".field--error input, .field--error textarea",
          ) as HTMLElement | null;
          firstError?.focus();
          if (status) {
            status.textContent =
              "Some required fields are missing. Please check the form above.";
            status.className = "form-status form-status--error";
          }
          return;
        }

        if (!form) return;
        const submitBtn = form.querySelector(
          "button[type='submit']",
        ) as HTMLButtonElement | null;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Sending…";
        }
        if (status) {
          status.textContent = "";
          status.className = "form-status";
        }

        try {
          const formData = new FormData(form);
          // The redirect field is only for the no-JS fallback; with fetch we
          // navigate ourselves so Web3Forms returns JSON instead.
          formData.delete("redirect");

          const response = await fetch(form.action, {
            method: "POST",
            body: formData,
            headers: { Accept: "application/json" },
          });
          const data = await response.json();

          if (response.ok && data.success) {
            window.location.href = "/thank-you";
          } else {
            throw new Error(data.message || "Submission failed");
          }
        } catch (error) {
          if (status) {
            status.textContent =
              "Something went wrong. Please try again, or email hello@kittycodecreative.com.";
            status.classList.add("form-status--error");
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Submit Questionnaire";
          }
        }
      }
    });
  });
</script>

<style>
  .questionnaire-form {
    max-inline-size: calc(1000px + 4rem);
    margin: 0 auto;
    inline-size: 100%;
    padding-inline: 1rem;
  }

  .questionnaire-form-inner {
    padding: 2rem;
    background: hsl(from var(--card) h s l / 0.05);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    backdrop-filter: blur(8px);
    position: relative;
    overflow: hidden;
    transition: all ease-in-out 0.5s;
  }

  .questionnaire-form-inner::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inset-inline-end: 0;
    block-size: 4px;
    background: linear-gradient(
      90deg,
      var(--primary),
      var(--primary),
      var(--info),
      var(--success),
      var(--primary)
    );
    background-size: 200% 100%;
    animation: shimmer 30s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%,
    100% {
      background-position: -200% 0;
    }
    50% {
      background-position: 200% 0;
    }
  }

  .questionnaire-form-inner:hover {
    border-color: hsl(from var(--primary) h s l / 0.3);
    box-shadow: 0 4px 20px hsl(from var(--primary) h s l / 0.1);
  }

  .questionnaire-heading {
    margin-block: 2rem 1.5rem;
    position: relative;
    z-index: 1;
  }

  .questionnaire-heading:first-of-type {
    margin-block-start: 0;
  }

  .questionnaire-legend {
    display: inline-block;
    padding-inline: 0;
    margin-block-end: 0.25rem;
    font-size: var(--legend-size);
    font-weight: 500;
    line-height: var(--space-s);
    color: var(--legend-color);
    position: relative;
    z-index: 1;
  }

  .questionnaire-fields {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-block-end: 2rem;
    position: relative;
    z-index: 1;
  }

  .questionnaire-field {
    border: none;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: transform 0.2s ease;
  }

  .questionnaire-field:focus-within {
    transform: translateY(-1px);
  }

  .questionnaire-field--full {
    grid-column: 1 / -1;
  }

  .questionnaire-options {
    border: none;
    padding: 0;
    margin: 0;
    margin-block-end: 2rem;
    position: relative;
    z-index: 1;
  }

  .questionnaire-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .questionnaire-actions {
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .botcheck {
    position: absolute !important;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .error-message {
    font-size: var(--step--2);
    color: var(--error);
    margin-block-start: 0.25rem;
    display: block;
    font-weight: 500;
    animation: slideInDown 0.3s ease;
  }

  .form-status {
    margin-block-start: 1.5rem;
    text-align: center;
    font-weight: 500;
    position: relative;
    z-index: 1;
  }

  .form-status:empty {
    display: none;
  }

  .form-status--success {
    color: var(--success);
  }

  .form-status--error {
    color: var(--error);
  }

  @keyframes slideInDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 768px) {
    .questionnaire-form {
      margin: 0;
      padding-inline: 0;
    }

    .questionnaire-form-inner {
      padding: 1.5rem 1rem;
    }

    .questionnaire-form-inner::before {
      animation: none;
    }

    .questionnaire-fields {
      grid-template-columns: 1fr;
    }

    .questionnaire-actions :global(.btn) {
      inline-size: 100%;
    }
  }
</style>
