---
import Pricing from "@/components/sections/Pricing.astro";
import { BadgePercent } from "@lucide/astro";

interface Props {
  cta?: { text: string; href: string };
}

interface Promo {
  title: string;
  badge?: string;
  text: string;
  linkText: string;
  linkHref: string;
  textAfter?: string;
}

const { cta } = Astro.props;

// Update for an active promotion:
function activePromo(): Promo | null {
  return null;

  // return {
  //   title: "Summer offer: 15% off",
  //   badge: "Ends 20th August",
  //   text: "We're taking 15% off one-off package prices and initial design fees. Mention the offer when you",
  //   linkText: "get in touch",
  //   linkHref: "/contact",
  //   textAfter: "and we'll apply it to your quote.",
  // };
}

const promo = activePromo();
---

<section id="services" class="section">
  <sparkly-text
    number-of-sparkles="5"
    style="--sparkly-text-color: color-mix(in srgb, currentColor, var(--primary) 100%);"
  >
    <mark>Simple, transparent pricing</mark>
  </sparkly-text>

  <h2>Services</h2>
  <p>
    We keep things simple with a focused set of website packages, so choosing is
    easy and hassle-free. Every package includes hosting, SEO and a fully
    bespoke, accessible build. Pay monthly to spread the cost, or as a one-off
    payment, whichever suits you best.
  </p>

  {
    promo && (
      <aside class="promo" aria-labelledby="promo-title">
        <div class="promo-header">
          <h3 id="promo-title" class="promo-title">
            <BadgePercent class="promo-icon" aria-hidden="true" />
            {promo.title}
          </h3>
          {promo.badge && <span class="promo-badge">{promo.badge}</span>}
        </div>
        <p class="promo-text">
          {promo.text} <a href={promo.linkHref}>{promo.linkText}</a>{" "}
          {promo.textAfter}
        </p>
      </aside>
    )
  }

  <Pricing cta={cta} />
</section>

<style>
  .promo {
    inline-size: 100%;
    margin-block: var(--space-m) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-block: var(--space-m);
    padding-inline: var(--space-l);
    text-align: start;
    background:
      linear-gradient(
        135deg,
        hsl(from var(--primary) h s l / 0.2),
        hsl(from var(--primary) h s l / 0.07)
      ),
      var(--background);
    border: 2px solid hsl(from var(--primary) h s l / 0.55);
    border-radius: var(--radius);
    box-shadow: 0 4px 24px hsl(from var(--primary) h s l / 0.25);
  }

  .promo-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
  }

  .promo-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-1);
    font-weight: 700;
    text-transform: capitalize;
  }

  .promo-icon {
    inline-size: 1rlh;
    block-size: 1rlh;
    flex-shrink: 0;
    color: var(--primary);
  }

  .promo-badge {
    margin-inline-start: auto;
    padding-block: 0.25rem;
    padding-inline: 0.75rem;
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--primary-foreground);
    background-color: var(--primary-background);
    border-radius: 999px;
  }

  .promo-text {
    max-inline-size: 70ch;
    font-size: var(--step-0);
    color: var(--foreground);
    text-wrap: pretty;
  }

  .promo-text a {
    color: inherit;
    font-weight: 500;
    text-decoration: underline 3px solid var(--primary);
    text-underline-offset: 2px;
    transition: color 0.3s ease;
  }

  .promo-text a:hover {
    color: var(--primary-text);
  }

  @media (max-width: 560px) {
    .promo {
      padding-inline: var(--space-m);
    }

    .promo-badge {
      margin-inline-start: 0;
    }
  }
</style>
