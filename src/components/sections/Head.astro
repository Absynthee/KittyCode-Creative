---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  author?: string;
  type?: "website" | "article";
  publishDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description = "KittyCode Creative is a web design agency based in Eastbourne, UK. We specialise in bespoke websites while ensuring accessibility and user-friendly designs.",
  image = "/og-image.png",
  canonical,
  noindex = false,
  author = "KittyCode Creative",
  type = "website",
  publishDate,
  updatedDate,
} = Astro.props;

const siteName = "KittyCode Creative";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const currentUrl = canonical || Astro.url.href;
const imageUrl = new URL(image, Astro.url.origin).href;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <ClientRouter />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />

  <meta name="author" content={author} />

  <link rel="canonical" href={currentUrl} />

  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content={type} />
  {
    type === "article" && publishDate && (
      <meta
        property="article:published_time"
        content={publishDate.toISOString()}
      />
    )
  }
  {
    type === "article" && updatedDate && (
      <meta
        property="article:modified_time"
        content={updatedDate.toISOString()}
      />
    )
  }
  {type === "article" && <meta property="article:author" content={author} />}
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:alt" content={`${siteName}: ${title}`} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="en_GB" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@KittyCodeCreate" />
  <meta name="twitter:url" content={currentUrl} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={`${siteName}: ${title}`} />

  <!-- Opaque on purpose: the mark is a black cat, so a transparent icon sinks
       into dark tab bars. public/favicon.png stays transparent for nav/hero/OG. -->
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <link rel="manifest" href="/site.webmanifest" />

  <meta name="theme-color" content="#d94713" />
  <meta name="msapplication-TileColor" content="#000" />

  <!-- Fonts are self-hosted via @fontsource-variable/inter, imported in
       Layout.astro. -->

  <!-- Prevents theme flash. Re-runs on astro:after-swap because the incoming
       page's <html> has no `dark` class until this reapplies it. -->
  <script is:inline>
    (function () {
      function applyTheme() {
        const savedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia?.(
          "(prefers-color-scheme: dark)",
        ).matches;
        const isDark = savedTheme ? savedTheme === "dark" : prefersDark;
        document.documentElement.classList.toggle("dark", isDark);
        window.__INITIAL_THEME__ = isDark;
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    })();
  </script>

  <meta
    name="facebook-domain-verification"
    content="u5px9xlv79fcbyx51ynvlt64qrsjj2"
  />
  <!-- Umami is proxied through /kc/ (rewrite in public/_redirects, beacon via
       netlify/edge-functions/umami-send.ts). data-host-url is required, and
       relative on purpose so previews report to their own origin. Only resolves
       on Netlify, so analytics is inert in `astro dev`. -->
  <script
    defer
    src="/kc/script.js"
    data-host-url="/kc"
    data-website-id="fd4e5c7b-e631-45b1-beef-6c040075417d"></script>

  <slot />
</head>
